#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);

    int minIndex = 0, maxIndex = 0;

    for (int i = 0; i < n; i++) {
        cin >> arr[i];

        if (arr[i] < arr[minIndex])
            minIndex = i;

        if (arr[i] > arr[maxIndex])
            maxIndex = i;
    }

    swap(arr[minIndex], arr[maxIndex]);

    for (int i = 0; i < n; i++) {
        cout << arr[i];
        if (i != n - 1)
            cout << " ";
    }

    return 0;
}
