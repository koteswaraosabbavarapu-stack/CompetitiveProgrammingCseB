#include <iostream>
#include <string>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    string s, p;
    if (!(cin >> s >> p)) {
        return 0;
    }

    int s_len = s.length();
    int p_len = p.length();
    
    int s_idx = 0, p_idx = 0;
    int star_idx = -1, s_backtrack_idx = -1;

    while (s_idx < s_len) {
        if (p_idx < p_len && (p[p_idx] == '?' || p[p_idx] == s[s_idx])) {
            s_idx++;
            p_idx++;
        }
        else if (p_idx < p_len && p[p_idx] == '*') {
            star_idx = p_idx;
            s_backtrack_idx = s_idx;
            p_idx++;
        }
        else if (star_idx != -1) {
            p_idx = star_idx + 1;
            s_backtrack_idx++;
            s_idx = s_backtrack_idx;
        }
        else {
            cout << 0 << "\n";
            return 0;
        }
    }

    while (p_idx < p_len && p[p_idx] == '*') {
        p_idx++;
    }

    if (p_idx == p_len) {
        cout << 1 << "\n";
    } else {
        cout << 0 << "\n";
    }

    return 0;
}
