#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int majority(vector<int>& nums){
    int n=nums.size();
    int maj=0;
    int count=0;
    for(int i=0;i<n;i++){
        if(count==0){
            maj=nums[i];
        }
        if(maj==nums[i]){
            count++;
        }
        else{
            count--;
        }
        
    }
    count=0;
    for(int num:nums){
        if(num==maj){
            count++;
        }
    }
    if(count>n/2) return maj;
    
    return -1;
}

int main() {
    int n;
    cin>>n;
    vector<int> nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    cout<<majority(nums);
    return 0;
}
