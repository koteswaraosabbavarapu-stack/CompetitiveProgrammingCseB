#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <bits/stdc++.h>;
using namespace std;


int main() {
    int m,n;
    cin>>m>>n;
    vector<vector<int>> grid(m,vector<int>(n));
    queue<pair<int,int>> q;
    
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            cin>>grid[i][j];
            if(grid[i][j]==2){
                q.push({i,j});
            }
        }
    } 
    int time=0;
    while(!q.empty()){
        int size=q.size();
        bool rotted=false;
        while(size--){
            auto [r,c]=q.front();
            q.pop();
            int dx[]={-1,0,1,0};
            int dy[]={0,1,0,-1};
            
            for(int k=0;k<4;k++){
                int dr=dx[k]+r;
                int dc=dy[k]+c;
                
                if(dr>=0 && dr<m && dc>=0 && dc<n &&grid[dr][dc]==1){
                    
                        grid[dr][dc]=2;
                        q.push({dr,dc});
                        rotted=true;
                    
                }
            }
          
        }
        
        if(rotted) time++;
    }
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {

            if(grid[i][j] == 1) {
                cout << -1;
                return 0;
            }
        }
    }
    cout<<time;
    return 0;
}
