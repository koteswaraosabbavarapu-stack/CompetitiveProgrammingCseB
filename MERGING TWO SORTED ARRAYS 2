#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    int m,n;
    cin>>m;
    int arr1[m];
    for(int i=0;i<m;i++){
        cin>>arr1[i];
    }
    cin>>n;
    int arr2[n];
    for(int i=0;i<n;i++){
        cin>>arr2[i];
    }
    int i=0,j=0,k=0;
    int ans[m+n];
    while(i<m && j<n){
        if(arr1[i]<arr2[j]){
            ans[k]=arr1[i];
            i++;
        }
        else{
            ans[k]=arr2[j];
            j++;
        }
        k++;
    }
    while(i<m){
        ans[k]=arr1[i];
        i++;
        k++;
    }
    while(j<n){
        ans[k]=arr2[j];
        j++;
        k++;
    }
    for(int i=0;i<m+n;i++){
        cout<<ans[i]<<" ";
    }
    
    return 0;
}
