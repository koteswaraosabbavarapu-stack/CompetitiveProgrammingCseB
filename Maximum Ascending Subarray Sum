#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int maxAscSub(vector<int>& nums){
    int n=nums.size();
    int maxSum=0;
    int sum=0;
    int left=0,prev=nums[0];
    for(int i=0;i<n;i++){
        if(nums[i]>=nums[left] && nums[i]>=prev){
            prev=nums[i];
            sum+=nums[i];
        }
        else{
            left=i;
            sum=nums[i];
        }
        maxSum=max(sum,maxSum);
        
    }
    return maxSum;
}
int main() {
    int n;
    cin>>n;
    vector<int> nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    } 
    cout<<maxAscSub(nums);
    return 0;
}
