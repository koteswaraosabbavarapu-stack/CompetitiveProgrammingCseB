#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;
    vector<int> a(n), b(m);
    for (int i = 0; i < n; i++) cin >> a[i];
    for (int i = 0; i < m; i++) cin >> b[i];

    int total = n + m;
    int mid = total / 2;

    int i = 0, j = 0, count = 0;
    long long prev = 0, curr = 0;

    while (count <= mid) {
        int val;
        if (i < n && (j >= m || a[i] <= b[j])) {
            val = a[i++];
        } else {
            val = b[j++];
        }
        prev = curr;
        curr = val;
        count++;
    }

    if (total % 2 == 1) {
        // print as X.0
        cout << curr << ".0" << "\n";
    } else {
        long long sum = prev + curr;
        long long wholePart = sum / 2;
        long long remainder = sum % 2;

        // handle negative sums correctly
        if (remainder != 0 && sum < 0) {
            wholePart -= 1;      // round toward negative infinity for whole part
            remainder = sum - wholePart * 2; // recompute remainder (will be positive)
        }

        long long decimalPart = (remainder * 10) / 2; // 0 or 5

        cout << wholePart << "." << decimalPart << "\n";
    }

    return 0;
}
