#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int maxSubArr(vector<int>&ans){
    int n=ans.size();
    int maxSum=ans[0];
    int currSum=ans[0];
    for(int i=1;i<n;i++){
        currSum=max(currSum+ans[i],ans[i]);
        maxSum=max(currSum,maxSum);
    }
    return maxSum;
}
int main() {
    int n;
    cin>>n;
    vector<int> ans(n);
    for(int i=0;i<n;i++){
        cin>>ans[i];
    }  
    cout<<maxSubArr(ans);
    return 0;
}
