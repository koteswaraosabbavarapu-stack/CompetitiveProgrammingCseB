#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int gcdOf(int n, int m) {
    while (m != 0) {
        int temp = m;
        m = n % m;
        n = temp;
    }
    return n;
}

int main() {
    int n, m, target;
    
    cin >> n >> m >> target; 
    
 
    if (target > (n + m)) {
        cout << "NO";
        return 0;
    }
    
    int gcd = gcdOf(n, m);
    
    if (target % gcd != 0) {
        cout << "NO"; 
    } else {
        cout << "YES";  
    }
    
    return 0;
}
