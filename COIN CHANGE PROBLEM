#include <bits/stdc++.h>
using namespace std;

int main() {
   
        int V, N;
        cin >> V >> N;

        vector<int> coins(N);
        for (int i = 0; i < N; i++) {
            cin >> coins[i];
        }

        vector<int> dp(V + 1, INT_MAX);
        dp[0] = 0;

        for (int amount = 1; amount <= V; amount++) {
            for (int coin : coins) {
                if (coin <= amount && dp[amount - coin] != INT_MAX) {
                    dp[amount] = min(dp[amount],
                                     dp[amount - coin] + 1);
                }
            }
        }

        if (dp[V] == INT_MAX)
            cout << -1 << '\n';
        else
            cout << dp[V] << '\n';
    
    return 0;
}
