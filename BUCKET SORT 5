#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<double> arr(n);
    bool bucketPossible = true;

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
        if (arr[i] < 0 || arr[i] >= 1)
            bucketPossible = false;
    }

    if (bucketPossible) {
        vector<vector<double>> buckets(n);

        for (double x : arr) {
            int idx = x * n;
            buckets[idx].push_back(x);
        }

        for (int i = 0; i < n; i++)
            sort(buckets[i].begin(), buckets[i].end());

        cout << fixed << setprecision(2);

        for (int i = 0; i < n; i++) {
            for (double x : buckets[i])
                cout << x << " ";
        }
    }
    else {
        sort(arr.begin(), arr.end());

        bool hasFraction = false;
        for (double x : arr) {
            if (x != (int)x) {
                hasFraction = true;
                break;
            }
        }

        if (hasFraction) {
            cout << fixed << setprecision(2);
            for (double x : arr)
                cout << x << " ";
        } else {
            for (double x : arr)
                cout << (int)x << " ";
        }
    }

    return 0;
}
